# Copier en .env.production sur le serveur (jamais dans Git) et remplir.
# Générer chaque secret avec :  openssl rand -base64 48
# Mot de passe de la base (lettres et chiffres seulement) :  openssl rand -hex 24

# Réseau Docker de Nginx Proxy Manager (voir docs/DEPLOIEMENT.md, étape 3)
PROXY_NETWORK=

POSTGRES_PASSWORD=

# Deux secrets différents, d'au moins 32 caractères.
JWT_SECRET=
# Chiffre les secrets de double authentification : NE JAMAIS LA CHANGER une fois en service.
ENCRYPTION_KEY=

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Adresse publique
CORS_ORIGIN=https://tricount.timotheebenchergui.fr
WEBAUTHN_RP_ID=tricount.timotheebenchergui.fr
WEBAUTHN_ORIGINS=https://tricount.timotheebenchergui.fr

# Cookies réservés à HTTPS
COOKIE_SECURE=true
# Proxys devant l'API : Nginx Proxy Manager, puis le nginx du conteneur web
TRUST_PROXY=2
