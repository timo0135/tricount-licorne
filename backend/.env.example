# Copier ce fichier en .env pour lancer l'API hors Docker.
NODE_ENV=development
DATABASE_URL="postgresql://licorne:licorne@localhost:5432/licorne_tricount?schema=public"

# En production : au moins 32 caractères aléatoires (openssl rand -base64 48).
JWT_SECRET="dev-uniquement-a-remplacer"
# Chiffrement des secrets de double authentification ; différente de JWT_SECRET.
# Ne jamais la changer en production : la 2FA de tous les comptes deviendrait inutilisable.
ENCRYPTION_KEY="dev-uniquement-cle-de-chiffrement"
# Durée du jeton d'accès ; la session est prolongée par le jeton de rafraîchissement.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

PORT=3000
CORS_ORIGIN=http://localhost:5173
# true en production (HTTPS obligatoire pour le cookie de session)
COOKIE_SECURE=false
# Nombre de proxys de confiance devant l'API (nginx du front, puis reverse proxy)
TRUST_PROXY=1
# Passkeys (Face ID, Touch ID) : nom de domaine exact du site et adresses autorisées.
# En production : WEBAUTHN_RP_ID=tricount.timotheebenchergui.fr
#                 WEBAUTHN_ORIGINS=https://tricount.timotheebenchergui.fr
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8080,http://localhost:5173
# Dossier des photos envoyées (profil, troupeau, bannière)
UPLOADS_DIR=./uploads
