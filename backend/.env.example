# Copier ce fichier en .env pour lancer l'API hors Docker.
NODE_ENV=development
DATABASE_URL="postgresql://licorne:licorne@localhost:5432/licorne_tricount?schema=public"

# En production : au moins 32 caractères aléatoires (openssl rand -base64 48).
JWT_SECRET="dev-uniquement-a-remplacer"
# Durée du jeton d'accès ; la session est prolongée par le jeton de rafraîchissement.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

PORT=3000
CORS_ORIGIN=http://localhost:5173
# true en production (HTTPS obligatoire pour le cookie de session)
COOKIE_SECURE=false
# Nombre de proxys de confiance devant l'API (nginx du front, puis reverse proxy)
TRUST_PROXY=1
# Dossier des photos envoyées (profil, troupeau, bannière)
UPLOADS_DIR=./uploads
